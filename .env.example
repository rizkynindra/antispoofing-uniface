# Copy to .env and adjust for this machine:
#   cp .env.example .env
# Leave CUDA_VISIBLE_DEVICES unset so every GPU from nvidia-smi is available.
# Set it only to hide devices, for example CUDA_VISIBLE_DEVICES=0,1

# Service
SERVICE_NAME=svc-face-compare
ENVIRONMENT=production
HOST=0.0.0.0
PORT=2112

# Gunicorn. run.py ignores WORKERS unless you pass --workers.
# Each worker loads the face models. Use 1 or 2 on a single smaller GPU,
# and 4 to 6 on a host with two 24 GB GPUs.
BIND=0.0.0.0:2112
WORKERS=2
OMP_NUM_THREADS=4

# Image fetch
S3_BASE_URL=
REQUEST_TIMEOUT=15
HTTP_TIMEOUT=15
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.0
REQUEST_DELAY=0.05

# Verdicts. Score >= match is the same person.
# Score >= confirmation and below match needs a person to confirm.
SIMILARITY_MATCH_THRESHOLD=0.75
NEED_CONFIRMATION_THRESHOLD=0.40
LIVENESS_THRESHOLD=0.50
SPOOFING_THRESHOLD=0.50

# Logs. Leave LOG_DIR unset to use face_compare_api/logs next to the app.
# {date} is filled by the logger as ddmmyyyy.
LOG_FILE_PATTERN=system_log_{date}.log

# Model weights
UNIFACE_CACHE_DIR=~/.uniface/models

# Batch face compare (face-compare.py)
COMPARE_INPUT_FILE=
COMPARE_OUTPUT_FILE=
COLUMN_PEMULIHAN=FOTO_PEMULIHAN
COLUMN_PENGKINIAN=FOTO_PENGKINIAN

# Batch liveness (process_excel_spoofing.py)
INPUT_FILE=input_urls.xlsx
OUTPUT_FILE=anti_spoofing_results.xlsx
URL_COLUMN=link_download_foto_diri
